# youtube-cleanup — copy to .env, or set these in ~/.tool-agents/youtube-cleanup/.env
# or in your shell. There are NO fallback defaults: a missing value is an error.

# DevTools Protocol endpoint of the Chrome you started with --remote-debugging-port
YOUTUBE_CLEANUP_CDP_URL=http://127.0.0.1:9222

# Absolute directory for the JSON/CSV manifests of what was found and removed
YOUTUBE_CLEANUP_OUTPUT_DIR=${HOME}/.tool-agents/youtube-cleanup/out

# How many lazy-load scrolls to perform — bounds how far back in history we walk
YOUTUBE_CLEANUP_MAX_SCROLLS=40

# Pause between consecutive removals, in milliseconds
YOUTUBE_CLEANUP_ACTION_DELAY_MS=700

# Maximum verify-by-reload passes during a clearing run
YOUTUBE_CLEANUP_MAX_PASSES=60
